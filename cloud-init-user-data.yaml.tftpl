#cloud-config
users:
  - name: ${username}
    lock_passwd: false
    ssh_authorized_keys:
      - ${public_key}
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    groups: [wheel]
# Lab-only: the password intentionally matches the username for easy access.
chpasswd:
  expire: false
  users:
    - name: ${username}
      password: ${username}
      type: text
ssh_pwauth: true
