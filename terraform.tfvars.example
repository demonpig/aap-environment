# General
# Used in instance names and as the OpenStack key-pair name.
username                  = "yourname"

# OS versions use standardized names: rhel8, rhel9, or rhel10.
# Provider-specific image identifiers are selected automatically.

# Controller
controller_count          = 1
controller_os_version     = "rhel10"

# EDA
eda_count                 = 0
eda_os_version            = "rhel10"

# Gateway
gateway_count             = 0
gateway_os_version        = "rhel10"

# Automation Hub
automation_hub_count      = 0
automation_hub_os_version = "rhel10"

# Database
database_count            = 0
database_os_version       = "rhel10"

# Execution Node
execution_node_count      = 0
execution_node_os_version = "rhel10"

# Managed Nodes
managed_node_count        = 0

# For OpenStack, use a separate Terraform state directory/state file; never toggle
# backends while reusing a state containing instances. Configure
# ~/.config/openstack/clouds.yaml before using the OpenStack backend.
